# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# This repo is PUBLIC. Double-check `git status` before every push.

# Razorpay TEST MODE credentials only. Generate from Dashboard (toggled to Test Mode) ->
# Account & Settings -> API Keys -> Generate Key. Never use Live Mode keys in this project.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set by you when configuring the webhook endpoint (Settings -> Webhooks, Test Mode).
# Razorpay does not generate this for you -- you choose the string, then Razorpay uses it
# to HMAC-SHA256-sign the X-Razorpay-Signature header on every webhook POST.
RAZORPAY_WEBHOOK_SECRET=

# For the narrator layer (M5) -- only needed once that milestone starts.
ANTHROPIC_API_KEY=
